# ==========================================
# DataPulse Phase 1 - Environment Variables
# Copy this file to .env and replace placeholders
# DO NOT COMMIT .env TO VERSION CONTROL
# ==========================================

# Database Configuration
POSTGRES_USER=postgres
DB_PASSWORD=your_secure_db_password_here
POSTGRES_DB=datapulse
DB_HOST=postgres
DB_PORT=5432

# Backend JWT & API Configuration
PORT=8000
NODE_ENV=production
JWT_SECRET=your_super_strong_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Service Inter-communication
PYTHON_EDA_URL=http://python-eda:5000
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=/app/uploads

# Container Registry & Image Versioning
DOCKER_REGISTRY=myhubuser
IMAGE_TAG=latest
